{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // トップレベルはローカル専用。`vp run setup:project` が案件 slug に更新する
  "name": "open-artifact-payload-local",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      // ローカルD1は database_id を持たせず、誤デプロイ時に本番D1へ接続できないようにする
      "database_name": "open-artifact-payload-local-cms",
      "remote": false,
    },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "<WORKER_NAME>"
    // },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "open-artifact-payload-local-cms",
      "remote": false,
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],
  // 問い合わせフォームの二次防御。namespace_id は同一 Cloudflare アカウント内で
  // 他の Rate Limiting binding と重複しない正の整数にする。
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],

  // 本番環境。セットアップ完了まで account_id は未設定、database_id はプレースホルダーにして誤デプロイを防ぐ。
  // wrangler は環境を指定するとトップレベルの bindings を継承しないため、本番値を明示する。
  "env": {
    "production": {
      "name": "open-artifact-payload",
      "services": [],
      "d1_databases": [
        {
          "binding": "D1",
          // `vp run setup:project` で作成または手動作成後に設定する
          "database_id": "<D1_DATABASE_ID>",
          "database_name": "open-artifact-payload-cms",
          "remote": true,
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "open-artifact-payload-cms",
          "remote": true,
        },
      ],
      "ratelimits": [
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
    },
  },
}
