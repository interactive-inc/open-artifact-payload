{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "open-artifact-payload",
  // 製品開発本部アカウント。複数アカウントに所属する環境で非対話デプロイを成立させるため明示
  "account_id": "9acefc4e7cfd25ff42cf1213f469f775",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      // `bun run setup:project` で自動置換される。手動セットアップの場合は `wrangler d1 create <name>` で生成された ID を貼る
      "database_id": "eabbe0ed-1d16-48de-b5cf-728e23a91a42",
      "database_name": "open-artifact-payload",
      "remote": true,
    },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "open-artifact-payload"
    // },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "open-artifact-payload",
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // 本番環境。`CLOUDFLARE_ENV=production` 指定時に使われる。
  // wrangler は環境を指定するとトップレベルの bindings を継承しないため、同じ値を再掲する
  "env": {
    "production": {
      "name": "open-artifact-payload",
      "services": [],
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "eabbe0ed-1d16-48de-b5cf-728e23a91a42",
          "database_name": "open-artifact-payload",
          "remote": true,
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "open-artifact-payload",
        },
      ],
    },
  },
}
