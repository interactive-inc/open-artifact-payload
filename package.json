{
  "name": "open-artifact-payload",
  "version": "0.1.0",
  "private": true,
  "description": "Inta CMS - Payload CMS + Next.js + Cloudflare D1/R2",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "vp lint",
    "check": "vp check",
    "cli": "bun packages/cli/lib/index.ts",
    "intacms": "bun packages/cli/lib/index.ts",
    "generate:types": "bun run generate:types:cloudflare && bun run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "bun run test:int && bun run test:e2e",
    "test:tools": "vp test run packages",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:ci": "bun run lint && bun run test:int",
    "test:int:migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_SECRET=test-secret-do-not-use-in-production payload migrate",
    "test:int": "bun run test:int:migrate && cross-env NODE_OPTIONS=--no-deprecation vp test run",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/project/scripts/seed.ts",
    "setup:project": "cross-env NODE_OPTIONS=--no-deprecation tsx src/core/scripts/setup-project.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@open-artifact/site-management": "workspace:*",
    "@payloadcms/db-d1-sqlite": "3.87.0",
    "@payloadcms/live-preview-react": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/plugin-mcp": "3.87.0",
    "@payloadcms/plugin-seo": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-r2": "3.87.0",
    "@payloadcms/translations": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "payload": "3.87.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "resend": "^6.18.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "10.4.0",
    "@storybook/addon-themes": "10.4.0",
    "@storybook/nextjs-vite": "10.4.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "22.19.9",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.5.4",
    "jsdom": "28.0.0",
    "postcss": "^8.5.25",
    "storybook": "10.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite": "catalog:",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "catalog:",
    "wrangler": "~4.61.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.9",
    "body-parser": "2.3.0",
    "dompurify": "3.4.13",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.5",
    "fast-xml-builder": "1.3.0",
    "fast-xml-parser": "5.10.1",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "immutable": "4.3.9",
    "js-yaml": "4.3.1",
    "postcss": "8.5.25",
    "qs": "6.15.2",
    "sharp": "0.35.3",
    "undici": "7.28.0",
    "vite": "catalog:",
    "ws": "8.21.1",
    "vitest": "catalog:"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vitest": "4.1.10",
    "vite-plus": "0.2.7"
  }
}
