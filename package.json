{
  "name": "open-artifact-payload",
  "version": "0.1.0",
  "private": true,
  "description": "Inta CMS - Payload CMS + Next.js + Cloudflare D1/R2",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "cloudflare:preflight": "tsx src/core/scripts/preflight-cloudflare-config.ts",
    "cloudflare:preflight-secrets": "tsx src/core/scripts/preflight-cloudflare-secrets.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "cli": "vp exec tsx packages/cli/lib/index.ts",
    "intacms": "vp exec tsx packages/cli/lib/index.ts",
    "generate:types": "vp run generate:types:cloudflare && vp run generate:types:payload",
    "generate:types:cloudflare": "tsx src/core/scripts/generate-cloudflare-types.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vp run test:storybook:dev && vp run test:storybook:static",
    "test:storybook:dev": "cross-env STORYBOOK_MODE=dev vp exec playwright test --config=playwright.storybook.config.ts",
    "test:storybook:static": "vp run build-storybook && cross-env STORYBOOK_MODE=static vp exec playwright test --config=playwright.storybook.config.ts",
    "test": "vp run test:int && vp run test:e2e",
    "test:tools": "vp test run packages",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" vp exec playwright test --config=playwright.config.ts",
    "test:ci": "vp check && vp run test:int && vp run test:tools && vp run test:cloudflare-config && bun audit --audit-level=high",
    "test:cloudflare-config": "vp test run tests/int/scripts/cloudflare-config.int.spec.ts && wrangler deploy --dry-run --strict --config tests/fixtures/cloudflare-worker/wrangler.jsonc --env=production && tsx src/core/scripts/generate-cloudflare-types.ts --check",
    "test:int:migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_SECRET=test-secret-do-not-use-in-production payload migrate",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vp test run",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/project/scripts/seed.ts",
    "audit:content": "cross-env NODE_OPTIONS=--no-deprecation tsx src/core/scripts/audit-content-constraints.ts",
    "setup:project": "cross-env NODE_OPTIONS=--no-deprecation tsx src/core/scripts/setup-project.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@open-artifact/site-management": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.2",
    "@payloadcms/db-d1-sqlite": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-mcp": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-r2": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "17.4.2",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "input-otp": "^1.4.2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "payload": "3.88.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "22.19.9",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.4",
    "jsdom": "28.0.0",
    "postcss": "^8.5.25",
    "shadcn": "^4.17.0",
    "storybook": "10.5.7",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-plus": "catalog:",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.6",
    "fast-xml-parser": "5.10.1",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "ws": "8.21.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite-plus": "0.2.8"
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}
