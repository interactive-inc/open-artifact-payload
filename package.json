{
  "name": "open-artifact-payload",
  "version": "0.1.0",
  "private": true,
  "description": "Inta CMS - Payload CMS + Next.js + Cloudflare D1/R2",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "cloudflare:preflight": "tsx src/core/scripts/preflight-cloudflare-config.ts",
    "cloudflare:preflight-secrets": "tsx src/core/scripts/preflight-cloudflare-secrets.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "cli": "vp exec tsx packages/cli/lib/index.ts",
    "intacms": "vp exec tsx packages/cli/lib/index.ts",
    "generate:types": "vp run generate:types:cloudflare && vp run generate:types:payload",
    "generate:types:cloudflare": "tsx src/core/scripts/generate-cloudflare-types.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vp run test:storybook:dev && vp run test:storybook:static",
    "test:storybook:dev": "cross-env STORYBOOK_MODE=dev vp exec playwright test --config=playwright.storybook.config.ts",
    "test:storybook:static": "vp run build-storybook && cross-env STORYBOOK_MODE=static vp exec playwright test --config=playwright.storybook.config.ts",
    "test": "vp run test:unit && vp run test:int && vp run test:e2e",
    "test:tools": "vp test run --project integration packages",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" vp exec playwright test --config=playwright.config.ts",
    "test:ci": "vp check && vp run test:unit && vp run test:int && vp run test:cloudflare-config && bun audit --audit-level=high --ignore=GHSA-vfj7-8cjw-p6xm",
    "test:cloudflare-config": "wrangler deploy --dry-run --strict --config tests/fixtures/cloudflare-worker/wrangler.jsonc --env=production && tsx src/core/scripts/generate-cloudflare-types.ts --check",
    "test:int:migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_SECRET=test-secret-do-not-use-in-production payload migrate",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vp test run --project integration",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed.ts",
    "audit:content": "cross-env NODE_OPTIONS=--no-deprecation tsx src/core/scripts/audit-content-constraints.ts",
    "setup:project": "cross-env NODE_OPTIONS=--no-deprecation tsx src/core/scripts/setup-project.ts",
    "test:unit": "vp test run --project unit",
    "test:e2e:development-access": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" vp exec playwright test --config=playwright.development-access.config.ts",
    "build:preview": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview --port 3000"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cloudflare/workers-oauth-provider": "^0.10.4",
    "@open-artifact/site-management": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.8",
    "@payloadcms/db-d1-sqlite": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-mcp": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.6.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "input-otp": "^1.5.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.6.5",
    "zod-from-json-schema": "0.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "28.1.0",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.1",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-plus": "catalog:",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "3.4.16",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.8",
    "fast-xml-parser": "5.10.1",
    "ip-address": "10.7.1",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss-selector-parser": "7.1.3",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2",
    "undici": "7.30.0",
    "ws": "8.21.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite-plus": "0.2.9"
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  },
  "patchedDependencies": {
    "@payloadcms/plugin-mcp@3.90.2": "patches/@payloadcms%2Fplugin-mcp@3.90.2.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}
