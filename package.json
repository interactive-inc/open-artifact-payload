{
  "name": "open-artifact-payload",
  "version": "0.1.0",
  "description": "Inta CMS - Payload CMS + Next.js + Cloudflare D1/R2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "bun run generate:types:cloudflare && bun run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vp test run",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/project/scripts/seed.ts",
    "setup:project": "cross-env NODE_OPTIONS=--no-deprecation tsx src/core/scripts/setup-project.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@payloadcms/db-d1-sqlite": "3.84.1",
    "@payloadcms/live-preview-react": "^3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/plugin-seo": "^3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-r2": "3.84.1",
    "@payloadcms/translations": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@tailwindcss/postcss": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "payload": "3.84.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "resend": "^6.1.2",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "10.4.0",
    "@storybook/addon-themes": "10.4.0",
    "@storybook/nextjs-vite": "10.4.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "22.19.9",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.5.0",
    "jsdom": "28.0.0",
    "postcss": "^8.5.9",
    "storybook": "10.4.0",
    "tailwindcss": "^4.3.0",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "wrangler": "~4.61.1",
    "vite-plus": "latest"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  }
}
