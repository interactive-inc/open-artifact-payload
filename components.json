{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-sera",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/app/(frontend)/[locale]/styles.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/app/(frontend)/_components",
    "utils": "@/app/(frontend)/_lib/utils",
    "ui": "@/app/(frontend)/_ui",
    "lib": "@/app/(frontend)/_lib",
    "hooks": "@/app/(frontend)/_hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {}
}
