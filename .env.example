# A generated secret for Payload
PAYLOAD_SECRET=

# Frontend base URL for live preview (default: http://localhost:3000)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Contact form (Cloudflare Turnstile + optional email)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# 問い合わせ通知メール (Resend)。3 つすべて設定で通知有効、未設定なら通知スキップ
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
# Resend の送信元アドレス。事前に Resend 側でドメイン認証を済ませる必要あり
CONTACT_NOTIFICATION_FROM="Contact <noreply@example.com>"
