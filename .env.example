# A generated secret for Payload (`openssl rand -hex 32`)
PAYLOAD_SECRET=

# Payload のログレベル (任意。デフォルト: info)
# PAYLOAD_LOG_LEVEL=info

# Frontend base URL for live preview / metadata (default: http://localhost:3000)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare Turnstile のサーバー側シークレット (検証用)。
# 公開サイトキーは環境変数ではなく管理画面「サイト設定」の turnstileSiteKey で設定する。
# 未設定のローカル開発では検証をスキップするが、本番では設定エラーとして送信を拒否する。
TURNSTILE_SECRET_KEY=

# 管理画面ダッシュボードのヘルプリンク宛先 (任意)
SUPPORT_EMAIL=

# メール送信 (Resend)。認証メール (パスワード再設定など) と問い合わせ通知の共通基盤。
# 未設定ならメールは送られず、宛先と件名だけがログに出る (ローカル開発の既定)
RESEND_API_KEY=
# 認証メールと通知メールの送信元。事前に Resend 側でドメイン認証を済ませる必要あり。
# 未設定なら CONTACT_NOTIFICATION_FROM を使う
EMAIL_FROM="Inta CMS <noreply@example.com>"

# 問い合わせ通知メールの宛先。RESEND_API_KEY と両方そろって通知有効、未設定なら通知スキップ
CONTACT_NOTIFICATION_EMAIL=
# 問い合わせ通知だけ別の送信元にしたい場合に設定する (未設定なら EMAIL_FROM)
CONTACT_NOTIFICATION_FROM=

# AI翻訳 (任意)。管理画面「AI翻訳設定」で選んだモデルのプロバイダ分だけ設定する
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI翻訳の上限の天井 (任意)。管理画面の設定値と env の小さい方が有効になる。
# クライアントに管理画面を渡す運用で、実装側が原価の上限を握りたい場合に設定する
# AI_TRANSLATION_MAX_MONTHLY_RUNS=100
# AI_TRANSLATION_MAX_MONTHLY_CHARACTERS=300000
# AI_TRANSLATION_MAX_MONTHLY_COST_USD=10
# AI_TRANSLATION_MAX_PER_RUN_CHARACTERS=20000

# AI API の接続先差し替え (任意)。Cloudflare AI Gateway を挟む場合に設定する
# AI_TRANSLATION_ANTHROPIC_API_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/anthropic/v1/messages
# AI_TRANSLATION_OPENAI_API_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/openai/chat/completions
